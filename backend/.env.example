# ==============================================================================
# Mini B2B RFQ Marketplace - Backend Environment Variables
# Copy to .env and configure for local development or production
# ==============================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=change-this-to-a-secure-32-character-secret-in-production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=b2b_rfq_db
DB_SSL=false
DB_POOL_LIMIT=10
